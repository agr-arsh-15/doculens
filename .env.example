# DocuLens configuration. Copy to .env and fill in what you need.
PORT=8000

# --- LLM (hybrid mode) -------------------------------------------------------
# Add ONE key to enable AI clause reasoning, chat answers and negotiation emails.
# Without a key DocuLens runs in local mode (playbook rules + embeddings).
# Groq (free tier, fast):   https://console.groq.com/keys
GROQ_API_KEY=
# Google Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenAI:
OPENAI_API_KEY=
# Force a provider (groq | gemini | openai | none). Empty = first provider with a key.
LLM_PROVIDER=
# Override the default model for the chosen provider (optional).
# Groq default: openai/gpt-oss-120b, falling back to openai/gpt-oss-20b and qwen/qwen3.8-27b when rate-limited.
LLM_MODEL=
# LLM_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
# Groq free-tier tuning: characters per AI batch, max batches per analysis, output tokens, parallel calls.
# The free tier allows about 8,000 tokens per minute per model, so long documents send only their
# highest-priority clauses to the AI (every clause is still checked by the rules).
# LLM_BATCH_CHARS=9000
# LLM_MAX_BATCHES=5
# LLM_MAX_OUTPUT_TOKENS=4096
# LLM_CONCURRENCY=2
# LLM_REASONING_EFFORT=low
# Check the key and current rate limits: cd backend && ../.venv/bin/python -m app.llm.check

# --- Embeddings --------------------------------------------------------------
# Neural ONNX embeddings are downloaded on first start (~130 MB). Set to 1 to use TF-IDF only.
DISABLE_NEURAL_EMBEDDINGS=0
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Limits and server -------------------------------------------------------
MAX_UPLOAD_MB=15
MAX_PAGES=120
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DOCULENS_DATA_DIR=./backend/data
