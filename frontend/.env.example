# Frontend build settings. Every VITE_ value ends up in the public JavaScript bundle, so only public values go here.
# Leave all of them unset for local development: the UI then talks to the API through the Vite proxy and
# runs without accounts (AUTH_MODE=local on the API).

# Hosted API (Render web service), e.g. https://doculens-api.onrender.com
# VITE_API_URL=

# Supabase project URL and publishable key (Project Settings -> API Keys). Setting these enables Google sign-in.
# VITE_SUPABASE_URL=https://<project>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
